@page "/login"
@inject AuthService AuthService
@inject UserSessionService SessionService
@inject NavigationManager NavigationManager

<h3>Login</h3>

<div class="mb-3">
    <input @bind="email" class="form-control" placeholder="Email" />
</div>
<div class="mb-3">
    <input @bind="password" type="password" class="form-control" placeholder="Password" />
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<button class="btn btn-primary" @onclick="HandleLogin" disabled="@isSubmitting">
    @(isSubmitting ? "Logging in..." : "Login")
</button>

@code {
    private string? email;
    private string? password;
    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter both email and password.";
            successMessage = null;
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await AuthService.Login(email, password);
            if (success)
            {
                SessionService.UserId = email;
                SessionService.Role = "User";
                successMessage = "Login successful. Redirecting...";
                await Task.Delay(250);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                errorMessage = "Invalid email or password.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to reach the authentication service.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
