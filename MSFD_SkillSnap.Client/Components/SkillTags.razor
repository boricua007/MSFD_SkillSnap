@page "/skills"
@using MSFD_SkillSnap.Client.Models
@using MSFD_SkillSnap.Client.Services
@inject SkillService SkillService

<section class="content-section">
    <div class="section-header">
        <h3>Core Skills</h3>
    </div>

    @if (skills == null)
    {
        <p class="empty-state"><em>Loading skills...</em></p>
    }
    else if (errorMessage != null)
    {
        <p class="empty-state error-state" role="alert">@errorMessage</p>
    }
    else if (skills.Count == 0)
    {
        <p class="empty-state">No skills available yet.</p>
    }
    else
    {
        <div class="skill-list">
            @foreach (var skill in skills)
            {
                <span class="skill-tag">
                    <strong>@skill.Name</strong>
                    <small>@skill.Level</small>
                </span>
            }
        </div>
    }

    <button class="btn btn-secondary mt-3" @onclick="AddDummySkill">Add Test Skill</button>

    @if (addSkillErrorMessage != null)
    {
        <p class="empty-state error-state" role="alert">@addSkillErrorMessage</p>
    }
</section>

@code {
    private List<Skill>? skills;
    private string? errorMessage;
    private string? addSkillErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            skills = await SkillService.GetSkillsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The skills API could not be reached.";
        }
    }

    private async Task AddDummySkill()
    {
        addSkillErrorMessage = null;
        var newSkill = new Skill
        {
            Name = "Test Skill",
            Level = "Beginner",
            PortfolioUserId = 1
        };

        var added = await SkillService.AddSkillAsync(newSkill);
        if (added != null)
        {
            skills ??= new List<Skill>();
            skills.Add(added);
        }
        else
        {
            addSkillErrorMessage = "Could not add skill. Log in first (this endpoint requires authorization).";
        }
    }
}
