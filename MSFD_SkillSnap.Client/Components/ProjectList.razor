@page "/projects"
@using MSFD_SkillSnap.Client.Models
@using MSFD_SkillSnap.Client.Services
@inject ProjectService ProjectService
@inject UserSessionService SessionService

<h3>Projects</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p role="alert">@errorMessage</p>
}
else if (projects.Count == 0)
{
    <p>No projects found.</p>
}
else
{
    <div class="project-grid">
        @foreach (var project in projects)
        {
            <ProjectCard Project="project" />
        }
    </div>
}

@if (SessionService.CurrentProject != null)
{
    <p>Currently editing: @SessionService.CurrentProject.Title</p>
}

@code {
    private List<Project> projects = new();
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            projects = await ProjectService.GetProjectsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The projects API could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
