@page "/projects"
@using MSFD_SkillSnap.Client.Models
@using MSFD_SkillSnap.Client.Services
@inject ProjectService ProjectService
@inject UserSessionService SessionService

<section class="content-section">
    <div class="section-header">
        <h3>Featured Projects</h3>
    </div>

    @if (isLoading)
    {
        <p class="empty-state"><em>Loading projects...</em></p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="empty-state error-state" role="alert">@errorMessage</p>
    }
    else if (projects.Count == 0)
    {
        <p class="empty-state">No projects found yet. Add one to get started.</p>
    }
    else
    {
        <div class="project-grid">
            @foreach (var project in projects)
            {
                <ProjectCard Project="project" />
            }
        </div>
    }

    @if (SessionService.CurrentProject != null)
    {
        <p class="selected-project">Currently editing: @SessionService.CurrentProject.Title</p>
    }
</section>

@code {
    private List<Project> projects = new();
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            projects = await ProjectService.GetProjectsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The projects API could not be reached.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
