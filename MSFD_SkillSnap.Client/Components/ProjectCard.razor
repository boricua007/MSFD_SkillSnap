@using MSFD_SkillSnap.Client.Models

<div class="project-card">
    <img src="@(string.IsNullOrWhiteSpace(Project.ImageUrl) ? "https://placehold.co/600x360/1d3557/ffffff?text=Project+Preview" : Project.ImageUrl)"
         alt="@Project.Title"
         class="project-image" />

    <div class="project-card-body">
        <h4>@Project.Title</h4>
        <p>@Project.Description</p>
    </div>
</div>

@code {
    [Parameter]
    public Project Project { get; set; } = new();
}
